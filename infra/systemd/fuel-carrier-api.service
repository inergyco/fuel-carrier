# DEPRECATED — use fuel-carrier-api@.service (ports 3010 / 3011) instead.
# Kept briefly so old docs/links do not 404; do not install this unit on new hosts.
[Unit]
Description=Fuel Carrier API (legacy single instance)
Documentation=https://github.com/inergyco/fuel-carrier
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=deploy
Group=deploy
WorkingDirectory=/var/www/fuel-carrier/api
Environment=NODE_ENV=production
ExecStart=/usr/bin/node dist/main.js
Restart=on-failure
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=30
StandardOutput=journal
StandardError=journal
SyslogIdentifier=fuel-carrier-api

[Install]
WantedBy=multi-user.target
