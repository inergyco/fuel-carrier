[Unit]
Description=Fuel Carrier API (port %i)
Documentation=https://github.com/inergyco/fuel-carrier
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=deploy
Group=deploy
WorkingDirectory=/var/www/fuel-carrier/api
# Prefer unit-level NODE_ENV so production cookies / Swagger / CORS rules always apply.
Environment=NODE_ENV=production
# Instance id is the listen port: fuel-carrier-api@3010, fuel-carrier-api@3011.
Environment=PORT=%i
# Nest also loads WorkingDirectory/.env (DATABASE_URL, JWT, MQTT, CORS, …).
# Do not put secrets in this unit file.
# MQTT: both instances may set MQTT_URL; use a shared subscription
# (MQTT_TELEMETRY_TOPIC=$share/fuel-carrier/telemetry/# or MQTT_SHARE_GROUP).
ExecStart=/usr/bin/node dist/main.js
Restart=on-failure
RestartSec=5
# Allow Nest enableShutdownHooks() to close MQTT / Redis / Postgres pool.
KillSignal=SIGTERM
TimeoutStopSec=30

# Journal only (Pino JSON → docs/api-logging.md)
StandardOutput=journal
StandardError=journal
SyslogIdentifier=fuel-carrier-api-%i

[Install]
WantedBy=multi-user.target
