# Copy to the VPS as /etc/fuel-carrier/backup.env (chmod 600).
# Never commit real secrets.

# Same-VPS dump via peer auth (no DB password).
PG_DUMP_USER=postgres
PG_DATABASE=fuel_carrier

# Where dumps are stored on this VPS before/while uploading.
BACKUP_DIR=/var/backups/fuel-carrier

# Keep this many recent dump files on the VPS (fast local restore).
KEEP_LOCAL=7

# Keep this many recent dump files in Arvan Object Storage.
KEEP_REMOTE=30

# Arvan Object Storage (S3-compatible)
S3_ENDPOINT=https://s3.ir-thr-at1.arvanstorage.ir
S3_BUCKET=fuel-carrier-db-backups
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Required by awscli; Arvan ignores region for routing but the value must be set.
AWS_DEFAULT_REGION=ir-thr-at1

# Optional: Uptime Kuma Push monitor URL (heartbeat for nightly backups).
# Create a "Push" monitor in Kuma, heartbeat ~26 hours, paste the Push URL here.
# KUMA_BACKUP_PUSH_URL=https://uptime.example.com/api/push/xxxxxxxx
