# Copy to postgres.conf (gitignored) and adjust.
#
# Local:
#   auth_opt_pg_host host.docker.internal
#   auth_opt_pg_password fuel_carrier_mqtt
#
# VPS (with docker-compose.prod.yml / network_mode: host):
#   auth_opt_pg_host 127.0.0.1
#   auth_opt_pg_password <strong-unique-secret>

auth_opt_pg_host host.docker.internal
auth_opt_pg_password fuel_carrier_mqtt
